# .htaccess – Clean URL configuration for extensionless URLs

# Enable mod_rewrite
RewriteEngine On

# -----------------------------------------------------------
# 1. Enforce HTTPS and Non-WWW (Canonical Domain/Protocol)
# -----------------------------------------------------------
RewriteCond %{HTTPS} off [OR]
RewriteCond %{HTTP_HOST} ^www\. [NC]
RewriteRule ^(.*)$ https://lustrestudio.uk/$1 [R=301,L]

# -----------------------------------------------------------
# 2. Redirect legacy/renamed pages (301 redirects)
# -----------------------------------------------------------
RewriteRule ^new-wedding-photographer-first-website-builder(\.html)?$ /services/website-development [R=301,NC,L]
RewriteRule ^wedding-cost-nj-2026(\.html)?$ / [R=301,NC,L]
RewriteRule ^wedding-photography-pricing-calculator(\.html)?$ / [R=301,NC,L]
RewriteRule ^tools(\.html)?$ /services/custom-tools [R=301,NC,L]
RewriteRule ^instagram-reels-wedding-photographers-2026(\.html)?$ / [R=301,NC,L]
RewriteRule ^blog(\.html)?$ / [R=301,NC,L]
RewriteRule ^blog/nyc-wedding-photographer-pricing-2026$ / [R=301,NC,L]
RewriteRule ^website(\.html)?$ /services/website-development [R=301,NC,L]

# -----------------------------------------------------------
# 3. Redirect any direct request for a .html file to the
#    extensionless version (clean URL) – 301 redirect.
# -----------------------------------------------------------
# The condition checks the original request line to avoid redirect loops.
RewriteCond %{THE_REQUEST} \s/([^\s]+?)\.html[\s?] [NC]
RewriteRule ^ %1 [R=301,L]

# -----------------------------------------------------------
# 4. Internally rewrite clean URLs (no .html) to the actual
#    .html files on disk so the server can serve the content.
# -----------------------------------------------------------
# If the request does not map to an existing file or directory
# but a corresponding .html file exists, rewrite it.
RewriteCond %{REQUEST_FILENAME} !-d
RewriteCond %{REQUEST_FILENAME} !-f
RewriteCond %{REQUEST_FILENAME}.html -f
RewriteRule ^(.*)$ $1.html [L]

# Optional: canonical trailing‑slash handling (remove trailing slash)
RewriteCond %{REQUEST_FILENAME} !-d
RewriteCond %{REQUEST_URI} .+/$
RewriteRule ^(.+?)/*$ $1 [R=301,L]

